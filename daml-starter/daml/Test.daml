-- Run with: daml test
module Test where

import DA.Time (addRelTime, hours)
import Daml.Script
import Iou
import Mandate

testIou : Script ()
testIou = script do
  bank  <- allocateParty "Bank"
  alice <- allocateParty "Alice"
  bob   <- allocateParty "Bob"

  iou <- submit bank do
    createCmd Iou with issuer = bank; owner = alice; amount = 100.0

  submitMustFail bob do exerciseCmd iou Give with newOwner = bob
  iou2 <- submit alice do exerciseCmd iou Give with newOwner = bob
  submitMustFail bob do exerciseCmd iou2 Split with splitAmount = 150.0
  pure ()

testMandate : Script ()
testMandate = script do
  alice    <- allocateParty "Alice"
  merchant <- allocateParty "Merchant"
  now      <- getTime
  let deadline = addRelTime now (hours 24)

  prop <- submit alice do
    createCmd MandateProposal with
      owner = alice; spender = merchant; cap = 100.0
      allowed = [merchant]; expiresAt = deadline
  m <- submit merchant do exerciseCmd prop Accept

  (m, _) <- submit merchant do exerciseCmd m Charge with amount = 30.0; payee = merchant
  (m, _) <- submit merchant do exerciseCmd m Charge with amount = 50.0; payee = merchant

  submitMustFail merchant do exerciseCmd m Charge with amount = 40.0; payee = merchant
  submitMustFail alice do exerciseCmd m Charge with amount = 1.0; payee = merchant

  submitMustFail merchant do exerciseCmd m Adjust with newCap = 500.0
  m <- submitMulti [alice, merchant] [] do exerciseCmd m Adjust with newCap = 200.0

  submit alice do exerciseCmd m Revoke
  submitMustFail merchant do exerciseCmd m Charge with amount = 1.0; payee = merchant
  pure ()

-- The agent cannot pay a party that is not on the allow-list, and cannot
-- charge after the mandate expires. Both fail on the ledger.
testAllowListAndExpiry : Script ()
testAllowListAndExpiry = script do
  alice    <- allocateParty "Alice2"
  agent    <- allocateParty "Agent"
  shop     <- allocateParty "Shop"
  stranger <- allocateParty "Stranger"
  now      <- getTime
  let deadline = addRelTime now (hours 24)

  prop <- submit alice do
    createCmd MandateProposal with
      owner = alice; spender = agent; cap = 100.0
      allowed = [shop]; expiresAt = deadline
  m <- submit agent do exerciseCmd prop Accept

  (m, _) <- submit agent do exerciseCmd m Charge with amount = 10.0; payee = shop
  submitMustFail agent do exerciseCmd m Charge with amount = 10.0; payee = stranger

  passTime (hours 25)
  submitMustFail agent do exerciseCmd m Charge with amount = 10.0; payee = shop
  pure ()

-- Every charge leaves a record the owner can read, and revoking the mandate
-- does not erase it.
testAuditSurvivesRevoke : Script ()
testAuditSurvivesRevoke = script do
  alice <- allocateParty "Alice3"
  agent <- allocateParty "Agent3"
  shop  <- allocateParty "Shop3"
  now   <- getTime
  let deadline = addRelTime now (hours 24)

  prop <- submit alice do
    createCmd MandateProposal with
      owner = alice; spender = agent; cap = 100.0
      allowed = [shop]; expiresAt = deadline
  m <- submit agent do exerciseCmd prop Accept

  (m, _) <- submit agent do exerciseCmd m Charge with amount = 20.0; payee = shop
  (m, _) <- submit agent do exerciseCmd m Charge with amount = 30.0; payee = shop

  submit alice do exerciseCmd m Revoke

  records <- query @ChargeRecord alice
  assertMsg "audit trail must survive revocation" (length records == 2)
  pure ()
